# Google OAuth redirect URI: https://YOUR-UI-HOST/api/auth/callback/google
AUTH_SECRET=replace-with-a-long-random-authjs-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Workspace domain (Google hd claim) and/or comma-separated verified personal emails.
KAPO_WORKSPACE_DOMAIN=example.com
KAPO_ALLOWED_EMAILS=person@gmail.com

# Server-only AgentOS destination. The proxy exchanges Google ID tokens with the backend.
AGENTOS_URL=http://localhost:7777
