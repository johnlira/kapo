OPENAI_API_KEY=sua-chave-openai
AGNO_QA_MODEL=gpt-5.4-mini
AGNO_QA_REASONING_EFFORT=low
AGNO_QA_PORT=7777
AGNO_QA_HOST=0.0.0.0
AGNO_QA_RELOAD=false
AGNO_QA_DB_FILE=.agno/sessions.db
AGNO_QA_NUM_HISTORY_RUNS=3
AGNO_QA_TOOL_CALL_LIMIT=8
# Same Google OAuth client ID and access rules configured on agent-ui.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
KAPO_WORKSPACE_DOMAIN=example.com
KAPO_ALLOWED_EMAILS=person@gmail.com
AGNO_QA_JWT_AUDIENCE=kapo-agentos
AGNO_QA_JWT_PRIVATE_KEY_FILE=.secrets/kapo-jwt-private.pem
# Copy the RS256 public verification key for this OS from os.agno.com to this file.
AGNO_OS_JWT_PUBLIC_KEY_FILE=.secrets/agno-os-public.pem
